{
  "name": "sightpress/module-interface",
  "description": "Module contracts for SightPress, a powerful CMS for everyone, designed with blind and low-vision creators and audiences in mind. Interfaces and value objects only, written in modern, object-oriented PHP.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "keywords": ["cms", "accessibility", "a11y", "wcag", "modules", "contracts"],
  "homepage": "https://sightpress.org",
  "support": {
    "issues": "https://github.com/sightpress/module-interface/issues",
    "source": "https://github.com/sightpress/module-interface"
  },
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "psr-4": {
      "SightPress\\Module\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SightPress\\Module\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@composer validate --strict --no-check-lock",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the PHPUnit test suites.",
    "check": "Run every check that must pass before a commit."
  }
}
